<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="HabitTracker.Views.HabitsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:HabitTracker.Models"
    xmlns:vm="clr-namespace:HabitTracker.ViewModels"
    x:DataType="vm:HabitsViewModel"
    Title="Привычки">

    <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="15">

        <!-- Кнопка добавления -->
        <Button Grid.Row="0" 
                Command="{Binding OpenAddHabitPopupCommand}" 
                Text="Добавить привычку" 
                HorizontalOptions="Start" />

        <!-- Список привычек -->
        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding Habits}"
                        SelectionMode="None">

            <!-- Если привычек нет -->
            <CollectionView.EmptyView>
                <Label Text="У вас пока нет привычек. Добавьте первую!" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" 
                       TextColor="Gray"/>
            </CollectionView.EmptyView>

            <!-- Шаблон карточки -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Habit">
                    <!-- Обертка для клика по всей карточке -->
                    <Border Margin="0,0,0,10" Padding="15" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="Gray">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer 
                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HabitsViewModel}}, Path=EditHabitCommand}"
                    CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <!-- Левая часть: Название и очки -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Category, Converter={StaticResource CategoryConverter}}" TextColor="Gray" FontSize="12" />
                            </VerticalStackLayout>

                            <!-- Очки -->
                            <Label Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                       Text="{Binding Points, StringFormat='{0} очков'}" 
                       TextColor="Green" FontAttributes="Bold" 
                       HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,10,0"/>

                            <!-- Кнопка удаления (ведро) -->
                            <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                        Text="🗑️" 
                        FontSize="20"
                        BackgroundColor="Transparent"
                        TextColor="Red"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HabitsViewModel}}, Path=DeleteHabitCommand}"
                        CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>